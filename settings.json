{
  "env": {
    "CLAUDE_ENV_FILE": "/Users/pd/.claude/env-setup.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "codex@openai-codex": true,
    "paxos-planning@paxos": true,
    "paxos@paxos": true
    "paxos@paxos": true,
    "entire@entire-skills": true
  },
  "extraKnownMarketplaces": {
