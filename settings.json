      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "paxos": {
      "source": {
        "source": "directory",
        "path": "/Users/pd/Developer/claude-marketplace"
